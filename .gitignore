# ──────────────────────────────────────────────
#  Python
# ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# Виртуальные окружения
.venv/
venv/
env/
ENV/
.env
.env.*
!.env.example

