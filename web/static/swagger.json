{
  "openapi": "3.0.3",
  "info": {
    "title": "Публичный API расписания",
    "version": "1.1.1",
    "description": "Открытый API для сторонних приложений: расписания групп, преподавателей и аудиторий, справочники и исходные файлы. Все операции используют GET. Регистрация и ключи доступа не нужны. Параметры передаются в строке запроса. Расписание: массив текстовых строк, не объектов занятий. Лимит: 10 запросов/секунду на IP и маршрут. При 429 используйте Retry-After; не опрашивайте API в бесконечном цикле. Ошибки содержат code и request_id; X-Request-ID есть также в заголовке. "
  },
  "servers": [
    {
      "url": "/",
      "description": "Этот сервер"
    }
  ],
  "tags": [
    {
      "name": "Расписание"
    },
    {
      "name": "Справочники"
    },
    {
      "name": "Файлы"
    }
  ],
  "paths": {
    "/api/schedule/group": {
      "get": {
        "operationId": "get_group_schedule",
        "tags": [
          "Расписание"
        ],
        "summary": "Расписание группы",
        "description": "Возвращает текстовые строки, без Telegram HTML. Если задана дата, возвращается только этот день либо 404; перехода на другую дату нет. Без даты возвращается последнее загруженное актуальное расписание.",
        "parameters": [
          {
            "name": "group",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "example": "103-Д9-3ИНС"
            }
          },
          {
            "name": "date",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[0-9]{2}\\.[0-9]{2}\\.[0-9]{4}$",
              "example": "12.09.2026",
              "description": "Существующая календарная дата ДД.ММ.ГГГГ. Для однозначного результата указывайте дату."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Успешный ответ",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Schedule"
                }
              }
            }
          },
          "400": {
            "description": "Ошибка параметров запроса",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Данные не найдены",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Метод не поддерживается",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Параметры отклонены сервисом расписания",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Превышен лимит запросов",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                },
                "description": "Секунд до повтора"
              }
            }
          },
          "500": {
            "description": "Внутренняя ошибка",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "Некорректный ответ сервиса расписания",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Сервис расписания недоступен",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "504": {
            "description": "Таймаут сервиса расписания",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
